    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
