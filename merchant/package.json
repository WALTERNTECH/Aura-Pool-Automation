{
  "name": "aura-pool-merchant",
  "version": "1.0.0",
  "private": true,
  "description": "Aura Pool merchant app: an installable web app for pool table owners",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
