{
  "name": "aura-pool-api",
  "version": "1.0.0",
  "private": true,
  "description": "Aura Pool Automation — payments, ledger, payouts and device control for pay-per-game pool tables",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "openapi": "tsx scripts/openapi.ts",
    "sim:device": "tsx scripts/device-sim.ts",
    "sim:provider": "tsx scripts/provider-sim.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "aedes": "1.2.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mqtt": "5.16.1",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "web-push": "3.6.7",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.15.3",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
