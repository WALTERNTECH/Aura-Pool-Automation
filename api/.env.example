# Copy to .env for local work. Without DATABASE_URL the API runs on an embedded Postgres
# (PGLITE_DIR keeps it between runs). Never commit real values.

NODE_ENV=development
PORT=4000
# DATABASE_URL=postgresql://aura_api.<project>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
PGLITE_DIR=../.local/pglite-dev
PUBLIC_URL=http://localhost:4000
MERCHANT_APP_URL=http://localhost:5310
ADMIN_APP_URL=http://localhost:5320

# Secrets (production: long random values)
JWT_SECRET=
MASTER_KEY=            # 64 hex chars
CALLBACK_SECRET=       # secret path segment on every M-Pesa callback URL
ADMIN_SETUP_TOKEN=     # creates the first super admin, once
PROXY_SECRET=          # shared with the merchant and console servers

# Payments: "simulated" (sandbox, no money moves) or "daraja"
PAYMENTS_PROVIDER=simulated
DARAJA_ENV=sandbox     # sandbox | production
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=      # the Paybill
DARAJA_PASSKEY=        # STK push (Lipa na M-Pesa Online)
DARAJA_INITIATOR=      # B2C, Transaction Status and Account Balance
DARAJA_SECURITY_CREDENTIAL=
DARAJA_B2C_COMMAND=BusinessPayment
DARAJA_C2B_RESPONSE_TYPE=Completed
DARAJA_IP_ALLOWLIST=   # comma separated; empty = Safaricom's published list in production; "off" disables
DARAJA_CREDENTIALS_ROTATED_AT=
PAYBILL_NUMBER=        # shown on table sheets; defaults to DARAJA_SHORTCODE

# Devices: embedded broker on /mqtt (default), or an external EMQX/Mosquitto
DEVICE_TRANSPORT=embedded
# MQTT_URL=mqtts://broker.example.com:8883
# MQTT_USERNAME=aura-server
# MQTT_PASSWORD=
# MQTT_HOOK_SECRET=    # the external broker calls /internal/mqtt/auth and /acl with this
# MQTT_PUBLIC_URL=     # what devices are told to connect to
# MQTT_TCP_PORT=1883   # plain MQTT for a bench on the local network
VIRTUAL_DEVICES=       # sandbox: run simulated ESP32s for devices marked virtual

# Messaging (unset = written to the log)
SMS_PROVIDER=          # africastalking | celcom
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
CELCOM_API_KEY=
CELCOM_PARTNER_ID=
CELCOM_SHORTCODE=
RESEND_API_KEY=
EMAIL_FROM="Aura Pool <alerts@example.com>"
VAPID_PUBLIC_KEY=      # web push: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Test mode only: show one-time codes on screen. Refused with live Daraja.
OTP_ECHO=on

# Optional bot check on the public pay page
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
